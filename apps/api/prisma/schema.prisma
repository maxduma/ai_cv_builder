// Data model. See the "Data model" section of the README for an overview.
// Conventions: UUIDv7 ids, timestamptz columns, snake_case table/column names.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  /// Stored trimmed and lowercased, so uniqueness is case-insensitive.
  email        String   @unique
  name         String
  /// scrypt hash with its parameters (see modules/auth/password-hasher.ts). Never selected by default.
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cvs Cv[]

  @@map("users")
}

model Cv {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  title          String
  targetRole     String?  @map("target_role")
  jobDescription String?  @map("job_description")
  /// The user's experience in their own words: one of the generation sources, next to an uploaded PDF.
  sourceText     String?  @map("source_text")
  /// Current structured CV document. Always validated against the shared content schema before it is written.
  content        Json?
  /// Incremented on every content write; used for optimistic locking between user edits and AI writes.
  contentVersion Int      @default(0) @map("content_version")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  generationJobs  GenerationJob[]
  sourceDocuments SourceDocument[]
  questions       CvQuestion[]

  // Jobs and documents reference (id, user_id) together, so the database guarantees
  // they always belong to the same user as their CV.
  @@unique([id, userId])
  @@index([userId, updatedAt])
  @@map("cvs")
}

enum GenerationJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@map("generation_job_status")
}

/// What a job does: write the CV from its sources, or apply one answer to a question to it.
enum GenerationJobKind {
  GENERATE
  APPLY_ANSWER

  @@map("generation_job_kind")
}

// A persistent, asynchronous AI job on a CV: its generation, or the update from an answer.
// Postgres acts as the queue: a worker claims PENDING jobs with `FOR UPDATE SKIP LOCKED` and keeps
// `heartbeat_at` fresh while processing.
model GenerationJob {
  id           String              @id @default(uuid(7)) @db.Uuid
  cvId         String              @map("cv_id") @db.Uuid
  userId       String              @map("user_id") @db.Uuid
  kind         GenerationJobKind   @default(GENERATE)
  /// The question whose answer an APPLY_ANSWER job applies.
  questionId   String?             @map("question_id") @db.Uuid
  status       GenerationJobStatus @default(PENDING)
  /// Validated snapshot of the parameters the job was created with.
  input        Json
  /// GENERATE: the validated AI output, copied to `cvs.content` on completion.
  /// APPLY_ANSWER: what the answer did ({ outcome, applied }).
  result       Json?
  /// Validated list of what the AI found missing or unclear in the sources (see shared GenerationIssue).
  issues       Json?
  attempts     Int                 @default(0)
  /// Current step of a processing job (0–3); 4 once it has completed.
  progressStep Int                 @default(0) @map("progress_step")
  errorCode    String?             @map("error_code")
  errorMessage String?             @map("error_message")
  startedAt    DateTime?           @map("started_at") @db.Timestamptz(3)
  heartbeatAt  DateTime?           @map("heartbeat_at") @db.Timestamptz(3)
  finishedAt   DateTime?           @map("finished_at") @db.Timestamptz(3)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  cv       Cv          @relation(fields: [cvId, userId], references: [id, userId], onDelete: Cascade)
  // Through (question_id, cv_id), so a job can only apply an answer to a question of its own CV.
  question CvQuestion? @relation(fields: [questionId, cvId], references: [id, cvId], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([cvId, createdAt])
  @@index([userId, createdAt])
  @@index([questionId, createdAt])
  @@map("generation_jobs")
}

enum CvQuestionStatus {
  OPEN
  SKIPPED
  ANSWERED
  DISMISSED

  @@map("cv_question_status")
}

// A question the AI asked about a CV (a shared GenerationIssue), kept until the person answers or
// dismisses it. Answering queues an APPLY_ANSWER job.
model CvQuestion {
  id        String           @id @default(uuid(7)) @db.Uuid
  cvId      String           @map("cv_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  /// Order in which the AI asked (most important first).
  position  Int
  /// A shared GENERATION_ISSUE_SECTIONS value.
  section   String
  /// A shared GENERATION_ISSUE_KINDS value.
  kind      String
  target    String
  /// The experience or education entry the question is about, if any.
  itemId    String?          @map("item_id")
  question  String
  why       String
  status    CvQuestionStatus @default(OPEN)
  /// The latest answer.
  answer    String?
  /// What the AI still needs after that answer, while the question is OPEN again.
  followUp  String?          @map("follow_up")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  cv   Cv              @relation(fields: [cvId, userId], references: [id, userId], onDelete: Cascade)
  jobs GenerationJob[]

  @@unique([id, cvId])
  @@index([cvId, position])
  @@map("cv_questions")
}

// A file the user uploaded as source material for a CV (e.g. an existing CV or a LinkedIn export).
model SourceDocument {
  id            String   @id @default(uuid(7)) @db.Uuid
  cvId          String   @map("cv_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  originalName  String   @map("original_name")
  mimeType      String   @map("mime_type")
  sizeBytes     Int      @map("size_bytes")
  pageCount     Int?     @map("page_count")
  /// Location of the file in file storage.
  storageKey    String   @unique @map("storage_key")
  /// Plain text extracted from the file; this is what the AI receives.
  extractedText String?  @map("extracted_text")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cv Cv @relation(fields: [cvId, userId], references: [id, userId], onDelete: Cascade)

  @@index([cvId, createdAt])
  @@map("source_documents")
}
