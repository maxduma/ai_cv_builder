# Copy this file to `.env`. Docker Compose reads it automatically.
# After changing values, run `docker compose up -d` so the containers are recreated.

# Anthropic API key: the only secret this project needs.
# It is required for AI features; without it the app still starts and reports AI as "not configured".
ANTHROPIC_API_KEY=

# ---- Optional ----

# Claude model used for CV generation (default: claude-opus-5-5).
# ANTHROPIC_MODEL=claude-opus-5-5

# API log level: fatal | error | warn | info | debug | trace | silent (default: info).
# LOG_LEVEL=debug

# CV generation uses a mock until Claude is wired up: four steps of this many milliseconds each
# (default: 2500), failing this share of runs, 0–1 (default: 0). Set 1 to see the failure screen.
# MOCK_GENERATION_STEP_MS=2500
# MOCK_GENERATION_FAIL_RATE=0

# Host ports. Change them if something else on your machine already uses them.
# WEB_PORT=5173
# API_PORT=4000
# DB_PORT=54320
