# Copy this file to `.env`. Docker Compose reads it automatically.
# After changing values, run `docker compose up -d` so the containers are recreated.

# Anthropic API key: Claude writes the CVs. Required in production. In development it can stay
# empty: a mock then "generates" clearly labelled sample CVs, and the health check reports AI as
# "not configured".
ANTHROPIC_API_KEY=

# Secret that signs session tokens (JWTs), at least 32 bytes. Required in production; generate one
# with `openssl rand -base64 48`. In development it can stay empty: the API then falls back to a
# public development secret and logs a warning.
JWT_SECRET=

# ---- Optional ----

# Claude model used for CV generation (default: claude-opus-5-5). The request uses Opus 5.5
# features (adaptive thinking, effort, server-side fallbacks), so other models may reject it.
# ANTHROPIC_MODEL=claude-opus-5-5

# How long one CV generation may take, retries included, before it fails as timed out, in
# milliseconds (1000–900000; default: 240000, i.e. 4 minutes).
# GENERATION_TIMEOUT_MS=240000

# API log level: fatal | error | warn | info | debug | trace | silent (default: info).
# LOG_LEVEL=debug

# Without ANTHROPIC_API_KEY (development only), the mock generator takes four steps of this many
# milliseconds each (default: 2500) and fails this share of runs, 0–1 (default: 0). Set 1 to see
# the failure screen.
# MOCK_GENERATION_STEP_MS=2500
# MOCK_GENERATION_FAIL_RATE=0

# Host ports. Change them if something else on your machine already uses them.
# WEB_PORT=5173
# API_PORT=4000
# DB_PORT=54320
